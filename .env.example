# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Groq API key — primary LLM provider for all AI analysis routes
# Get yours: https://console.groq.com/keys
GROQ_API_KEY=

# Admin authentication token — gates all content-management POST/DELETE endpoints
# (Thought Leadership, Innovator Illumination, Studio Updates, image uploads)
# Use any strong random string; value is compared directly in x-admin-token header
ADMIN_PUBLISH_TOKEN=


# ── SUPABASE  (required for persistent content storage) ───────────────────────
# Create a free project at https://supabase.com, then run supabase/schema.sql
# in the SQL Editor (Dashboard → SQL Editor → New query → paste → Run).
#
# Find these values in: Project Settings → API
SUPABASE_URL=                    # e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=       # "service_role" key — server-side only, never expose to browser


# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Cerebras API key — unlocks Qwen 3 235B and other Cerebras-hosted models
# Get yours: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=

# Tavily API key — powers the /api/research web-search endpoint
# Get yours: https://tavily.com/
TAVILY_API_KEY=

# ADANOS sentiment API key — powers the /api/sentiment endpoint
ADANOS_API_KEY=

# Override the default LLM model globally (defaults to llama-3.3-70b-versatile)
# STEEP_DEFAULT_MODEL=llama-3.3-70b-versatile
